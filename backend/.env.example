PORT=5000
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=your_token_duration
NODE_ENV=development
CLIENT_URL=your_frontend_origin
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Optional
# TRUST_PROXY=1
# REQUIRE_SUBSCRIPTION=false
# RATE_LIMIT_USER=600
# RATE_LIMIT_IP=5000
# RATE_LIMIT_AUTH_FAILS=20
# RATE_LIMIT_AUTH_IP=200

# AI (Phase X6). Optional: without these keys AI features say "AI is not set up yet" and nothing else breaks.
# Cloudflare Workers AI free tier: account ID and an API token with Workers AI access. Never commit real values.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional: AI_MODEL picks another id from src/config/ai.js. AI_PROVIDER=fake uses the offline test model.
AI_MODEL=
AI_PROVIDER=

# Demo seed (npm run seed:demo)
DEMO_STUDENT_EMAIL=
DEMO_STUDENT_PASSWORD=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# Core server configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (use separate databases for dev and test, e.g. catalyst_dev)
MONGODB_URI=mongodb://127.0.0.1:27017/catalyst_dev

# Auth (JWT stored in an httpOnly cookie named "token")
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=7d

# Cloudinary uploads (images & PDF materials)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Optional production & access settings
# TRUST_PROXY=1
# REQUIRE_SUBSCRIPTION=false
# LOG_LEVEL=info

# Optional rate limits (15-minute windows)
# RATE_LIMIT_IP=1000
# RATE_LIMIT_AUTH_FAILS=20

# Demo seed (npm run seed:demo)
# DEMO_STUDENT_EMAIL=
# DEMO_STUDENT_PASSWORD=
# DEMO_ADMIN_EMAIL=
# DEMO_ADMIN_PASSWORD=
